# -------------------------------------------------------
# Mattermost — Environment Variables Template
# Copy this file to .env and fill in real values.
# The .env file is git-ignored and must NOT be committed.
# -------------------------------------------------------

# Fully-qualified domain name used for TLS and the Mattermost Site URL.
# For intranet deployments this is typically an internal DNS name.
DOMAIN=chat.company.internal

# Password for the Mattermost PostgreSQL user (mmuser).
# Use a strong, unique password in production.
MM_DB_PASSWORD=Ch4ng3M3N0w!!Str0ng

# Firebase Cloud Messaging API key for Android push notifications.
# Leave as "placeholder" if internet access is unavailable — the push
# proxy will start but silently skip FCM delivery without crashing.
FCM_API_KEY=placeholder
